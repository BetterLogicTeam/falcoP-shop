# ==========================================
# FALCO PEAK SHOP - Environment Variables
# ==========================================
# Copy this file to .env and fill in your values

# ==========================================
# DATABASE - Supabase PostgreSQL
# ==========================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/database

# Connection pooler for app (use port 6543 with pgbouncer)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for migrations (use port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres"

# ==========================================
# STRIPE - Payment Processing
# ==========================================
# Get these from: https://dashboard.stripe.com/apikeys

# Server-side secret key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY="sk_test_your_secret_key"

# Publishable key for server-side use
STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# Client-side publishable key (NEXT_PUBLIC_ prefix exposes to browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# Stripe CLI (optional): winget install Stripe.StripeCli
#   npm run stripe:login   — links CLI to a Stripe account (browser approve)
#   npm run stripe:whoami  — shows which account the CLI uses
#   npm run stripe:logs    — tail API logs for that account
#   npm run stripe:verify       — validate keys (test or live); secret + publishable must match mode
#   npm run stripe:verify:live  — same, but only succeeds with sk_live_ + pk_live_ (production)
#   npm run stripe:verify:live -- --debug — prints key lengths + charset check (no secret printed)
# The app still reads STRIPE_* from this file; copy keys from Dashboard → Developers → API keys.
#
# --- Production (live Stripe + Klarna) — no extra env vars for Klarna ---
# Klarna is activated through Stripe, not a separate API key in this project.
# 1) Turn off "Test mode" in Stripe; use sk_live_ + pk_live_ in Vercel (and redeploy).
# 2) Stripe Dashboard → Settings → Payment methods → enable Klarna for LIVE (complete any onboarding /
#    Klarna agreement Stripe shows — live Klarna is not automatic until the account is approved).
# 3) Same keys on server + NEXT_PUBLIC_* so PaymentIntents and Elements stay in live mode.
# 4) Customer country + currency (SEK) must match what Klarna supports for your Stripe region.
# Docs: https://docs.stripe.com/payments/klarna

# ==========================================
# FRAKTJAKT - Freight Integration (Webhook + Tracking)
# ==========================================
# Register webhook URL in Fraktjakt:
#   https://www.falcop.com/api/webhooks/fraktjakt
# Optional shared secret (recommended):
#   Send this value in header: x-fraktjakt-token
FRAKTJAKT_WEBHOOK_TOKEN=""

# ==========================================
# CLOUDINARY - Image Uploads
# ==========================================
# Get these from: https://console.cloudinary.com/settings/api-keys

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ==========================================
# NEXTAUTH - Authentication
# ==========================================
# Generate secret: openssl rand -base64 32

NEXTAUTH_SECRET="generate-a-secure-random-string-here"
NEXTAUTH_URL="http://localhost:3000"

# ==========================================
# NEWSLETTER — subscriber checkout discount (10%)
# ==========================================
# Creates/uses a Coupon row in the database (required for checkout). Default code FALCO10 if unset.
# Set the same value for NEXT_PUBLIC_* so the site can show the code before subscribe if needed.

NEWSLETTER_SUBSCRIBER_COUPON_CODE="FALCO10"
NEXT_PUBLIC_NEWSLETTER_SUBSCRIBER_COUPON_CODE="FALCO10"

# ==========================================
# EMAIL - SMTP (Optional)
# ==========================================
# For sending order confirmations, notifications, etc.

SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# ==========================================
# SECURITY NOTES (production checklist)
# ==========================================
# - Never commit .env / .env.local. Use Vercel (or host) env UI for secrets.
# - Only NEXT_PUBLIC_* belongs in the browser; everything else is server-only.
# - STRIPE_SECRET_KEY, DATABASE_URL, NEXTAUTH_SECRET, CLOUDINARY_API_SECRET,
#   FRAKTJAKT_WEBHOOK_TOKEN must be long random values; rotate if leaked.
# - Admin APIs require an admin NextAuth session (sign in at /admin/login), including:
#   /api/orders (GET/POST), /api/orders/[id], /api/products (POST), /api/products/[id] (PUT/DELETE),
#   /api/upload, /api/coupons, /api/coupons/[id], /api/settings, /api/customers, /api/customers/[id],
#   /api/analytics.
# - Checkout recalculates cart totals from the database and checks the Stripe
#   PaymentIntent amount matches the server total before marking paid.
# - Guest order lookup: GET /api/orders/lookup needs order number + email (do not share links
#   that expose both).
# - Fraktjakt webhook: set FRAKTJAKT_WEBHOOK_TOKEN and send it as header x-fraktjakt-token.
#   Query ?token= is supported for some test tools; prefer header only in production if possible.
